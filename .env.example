# OpenDART API Key (https://opendart.fss.or.kr/)
DART_API_KEY=your_dart_api_key_here

# Google Gemini API Key (https://aistudio.google.com/ — 무료)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily API Key - 웹 검색용 (선택, 없으면 DuckDuckGo 사용)
TAVILY_API_KEY=

# 기본 분석 대상 기업
DEFAULT_COMPANY_CODE=005930
DEFAULT_COMPANY_NAME=삼성전자

# LangGraph 체크포인트 저장 경로
CHECKPOINT_DIR=./checkpoints

# 감사 로그 저장 경로
AUDIT_LOG_DIR=./audit_logs

# Streamlit 서버 포트
STREAMLIT_PORT=8501
